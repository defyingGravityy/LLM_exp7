# Copy to .env and fill in. NEVER commit .env
BACKEND=ollama          # ollama | cloud | mock

# Option B - Ollama (run: ollama pull qwen2.5:0.5b)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

# Option A - Cloud (OpenAI-compatible endpoint, e.g. Hugging Face router)
CLOUD_BASE_URL=https://router.huggingface.co/v1
CLOUD_MODEL=your-model-id-here
CLOUD_API_KEY=your-key-here

# Retrieval relevance cut-off (cosine similarity, 0-1). Raise it if unsupported
# questions still get answered; lower it if valid questions hit the fallback.
MIN_SIMILARITY=0.30
